<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.PlaylistMaker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="actionBarSize">48dp</item>
        <item name="buttonTextColor">@color/alternative_black</item>
        <item name="backgroundColorPrimary">@color/alternative_black</item>
        <item name="backgroundColorSecondary">@color/white</item>
        <item name="textColorPrimary">@color/white</item>
        <item name="iconsTintColor">@color/white</item>
        <item name="searchBarBackground">@color/white</item>
        <item name="searchBarElementColor">@color/alternative_black</item>
        <item name="trackTitle">@color/white</item>
        <item name="PlaceholderTextColor">@color/white</item>
        <item name="android:backgroundTint">@color/alternative_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="updateButtonBackground">@color/white</item>
        <item name="updateButtonTextColor">@color/alternative_black</item>
        <item name="searchBarBackgroundColor">@color/white</item>
        <item name="ic_error_color">@color/white</item>
        <item name="ic_no_results_color">@color/white</item>
        <item name="TrackNameTextColor">@color/white</item>
        <item name="switchTrackColor">@color/switch_track_color_dark</item> ////
        <item name="switchThumbColor">@color/switch_thumb_color_dark</item>

        <item name="colorPrimary">@color/blue</item>
        <item name="colorIconPrimary">@color/black_app</item>
        <item name="colorPrimaryVariant">@color/black_app</item>
        <item name="colorOnPrimary">@color/alternative_black</item>
        <item name="colorSecondary">@color/white</item>
        <item name="textColorSecondary">@color/white</item>
        <item name="colorIconSecondary">@color/white</item>
        <item name="colorSecondaryVariant">@color/black_app</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="cursorColor">@color/blue</item>
        <item name="editTextBackgroundColor">@color/white</item>
        <item name="textColorSearchHint">@color/black_app</item>
        <item name="clearButtonColor">@color/black_app</item>

        <item name="playerIconsMediaColor">@color/white</item>
        <item name="colorIconArrowBack">@color/white</item>


        <item name="materialAlertDialogTheme">@style/MyAlertDialogTheme</item>

        <item name="bottomSheetColor">@color/edit_text_grey</item>
        <item name="rounder_bsh">@color/white</item>

        <item name="elevationOverlayEnabled">false</item>
        <item name="android:forceDarkAllowed">false</item>



        <item name="colorSurface">@color/edit_text_grey</item>
        <item name="android:windowBackground">@color/edit_text_grey</item>
        <item name="android:navigationBarColor">@color/edit_text_grey</item>
        <item name="colorBackground">@color/edit_text_grey</item>
        <item name="textColorSecondaryPlInfo">@color/alternative_black</item>
        <item name="playlistInfoBackground">#E6E8EB</item>
    </style>

    <!-- Тема для диалогов -->
    <style name="MyAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="actionButtonStyle">@style/MyAlertDialogButton</item>
    </style>

    <!-- Кнопки диалогов -->
    <style name="MyAlertDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/blue</item>
    </style>

    <style name="Theme.PlaylistMaker.PlaylistInfo" parent="Theme.PlaylistMaker">
        <!-- Устанавливаем фон ОКНА на нужный светло-серый цвет -->
        <item name="android:windowBackground">@color/edit_text_grey</item>
        <!-- Override background attributes specifically for PlaylistInfo -->
        <item name="backgroundColorPrimary">#E6E8EB</item>
        <item name="android:backgroundTint">#E6E8EB</item>
        <item name="colorPrimaryVariant">@color/alternative_black</item>
        <item name="colorSecondaryVariant">@color/alternative_black</item>
        <item name="bottomSheetColor">#E6E8EB</item>
    </style>

</resources>