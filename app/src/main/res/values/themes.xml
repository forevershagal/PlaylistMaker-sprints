<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PlaylistMaker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="actionBarSize">48dp</item>
    </style>

    <style name="Theme.PlaylistMaker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="actionBarSize">48dp</item>
        <item name="buttonTextColor">@color/alternative_black</item>
        <item name="backgroundColorPrimary">@color/background_blue</item>
        <item name="backgroundColorSecondary">@color/white</item>
        <item name="textColorPrimary">@color/alternative_black</item>
        <item name="iconsTintColor">@color/icon_gray</item>
        <item name="searchBarBackground">@color/search_bar_background</item>
        <item name="searchBarElementColor">@color/search_bar_text_color</item>
        <item name="trackTitle">@color/black</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="updateButtonBackground">@color/alternative_black</item>
        <item name="updateButtonTextColor">@color/white</item>
        <item name="searchBarBackgroundColor">@color/search_bar_background_color_lite</item>
        <item name="PlaceholderTextColor">@color/alternative_black</item>
        <item name="ic_error_color">@color/alternative_black</item>
        <item name="ic_no_results_color">@color/alternative_black</item>
        <item name="TrackNameTextColor">@color/black</item>
        <item name="switchTrackColor">@color/switch_track_color_lite</item>
        <item name="switchThumbColor">@color/switch_thumb_color_lite</item>
        <item name="playerIconsTintColor">@color/metallic_grey</item>

        <item name="colorPrimary">@color/blue</item>
        <item name="colorIconPrimary">@color/black_app</item>
        <item name="colorPrimaryVariant">@color/blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/white</item>
        <item name="textColorSecondary">@color/black_app</item>
        <item name="colorIconSecondary">@color/grey</item>
        <item name="colorSecondaryVariant">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="cursorColor">@color/blue</item>
        <item name="editTextBackgroundColor">@color/edittext_background</item>
        <item name="textColorSearchHint">@color/grey</item>
        <item name="clearButtonColor">@color/clear_button_color</item>

        <item name="playerIconsMediaColor">@color/alternative_black</item>

        <item name="colorIconArrowBack">@color/alternative_black</item>
        <item name="materialAlertDialogTheme">@style/MyAlertDialogTheme</item>

        <item name="bottomSheetColor">@color/white</item>
        <item name="rounder_bsh">@color/edit_text_grey</item>

        <item name="colorBackground">@color/edit_text_grey</item>

        <item name="colorSurface">@color/edit_text_grey</item>
        <item name="textColorSecondaryPlInfo">@color/alternative_black</item>
    </style>

    <!-- Тема для диалогов -->
    <style name="MyAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="actionButtonStyle">@style/MyAlertDialogButton</item>
    </style>

    <!-- Кнопки диалогов -->
    <style name="MyAlertDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/blue</item>
    </style>

    <style name="Theme.PlaylistMaker.PlaylistInfo" parent="Theme.PlaylistMaker">
        <!-- Устанавливаем фон ОКНА на нужный светло-серый цвет -->
        <item name="android:windowBackground">@color/edit_text_grey</item>

    </style>

</resources>