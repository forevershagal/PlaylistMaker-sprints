<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MainButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">?attr/buttonTextColor</item>
        <item name="cornerRadius">16sp</item>
        <item name="iconTintMode">multiply</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">24dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="ToolbarTextAppearance">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">?attr/textColorPrimary</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="CustomToolbarStyle">
        <item name="android:paddingTop">4dp</item>
        <item name="contentInsetStart">0dp</item>
    </style>

    <style name="SettingsItemStyle">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="SettingsSpaceStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="SettingsTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsIconStyle">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="tint">?attr/iconsTintColor</item>
    </style>

    <style name="TrackCellText">
        <item name="fontFamily">@font/ys_display_regular</item>
    </style>

    <style name="TrackCellText.TrackTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/trackTitle</item>
    </style>

    <style name="TrackCellText.Subtitle">
        <item name="android:singleLine">true</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/iconsTintColor</item>
    </style>

    <style name="PlaceholderText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">24dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">?attr/PlaceholderTextColor</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="UpdateButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">54dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>

        <item name="android:background">@drawable/rounded_button</item>
        <item name="android:textColor">?attr/updateButtonTextColor</item>
    </style>

    <style name="SettingsButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="cornerRadius">0dp</item>
    </style>

    <style name="TrackNameTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">?attr/TrackNameTextColor</item>
    </style>

    <style name="TrackInfoTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/icon_gray</item>
    </style>

    <style name="ToolbarTitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextView_track">
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Button_placeholder" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_gravity">center</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:backgroundTint">?attr/colorOnSecondary</item>
        <item name="cornerRadius">54dp</item>
        <item name="android:visibility">gone</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Track_info_description">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/grey</item>
    </style>

    <style name="Track_info" parent="Track_info_description">
        <item name="android:textColor">?attr/textColorSecondary</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="layout_constrainedWidth">true</item>
        <item name="layout_constraintHorizontal_bias">1.0</item>
    </style>

    <style name="ToolbarPlayer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:layout_marginBottom">24dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="titleTextColor">?attr/textColorSecondary</item>
        <item name="contentInsetStartWithNavigation">8dp</item>
    </style>

    <style name="MainBackgroundStyle">
        <item name="android:background">@color/blue</item>
    </style>

    <style name="MainTextViewStyle">
        <item name="android:textColor">@color/white</item>
    </style>



    <style name="SettingBackgroundStyle">
        <item name="android:background">@color/white</item>
    </style>

    <style name="SettingHeaderStyle">
        <item name="android:textColor">@color/black_for_settings</item>
    </style>

    <style name="BackArrowStyle">
        <item name="tint">@color/black_for_settings</item>
    </style>

    <style name="DarkThemeButtonStyle">
        <item name="android:textColor">@color/black_for_other</item>
    </style>

    <style name="SwitchButtonStyle">
        <item name="thumbTint">@color/switch_thumb_inactive_color</item>
        <item name="trackTint">@color/switch_track_inactive_color</item>
    </style>

    <style name="SettingButtonStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/item_height</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="SettingTextViewStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/black_for_other</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>

    <style name="SettingImageViewStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/margin_start</item>
        <item name="tint">@color/grey</item>
    </style>

    <style name="EditTextBgStyle">
        <item name="android:backgroundTint">@color/edit_text_grey</item>
    </style>

    <style name="EditTextImageStyle">
        <item name="tint">@color/text_color_hint</item>
    </style>

    <style name="EditTextHintStyle">
        <item name="android:textColorHint">@color/text_color_hint</item>
    </style>

    <style name="ArrowTrackStyle">
        <item name="tint">@color/grey</item>
    </style>

    <style name="AuthorTextStyle">
        <item name="android:textColor">@color/text_color_hint</item>
    </style>

    <style name="NoInternetPicture">
        <item name="android:src">@drawable/ic_error</item>
    </style>


    <style name="NoResultsPicture">
        <item name="android:src">@drawable/ic_no_results</item>
    </style>

    <style name="RoundButton">
        <item name="android:backgroundTint">@color/grey2</item>
    </style>

    <style name="PlayButton">
        <item name="android:background">?attr/playerIconsMediaColor</item>
        <item name="android:src">@drawable/play_button</item>
    </style>

    <style name="PressedPlayButton">
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:src">@drawable/pause_button</item>
    </style>

    <style name="TabIndicator">
        <item name="tabIndicatorColor">?attr/textColorPrimary</item>
        <item name="android:background">@color/white</item>
        <item name="tabTextColor">?attr/textColorPrimary</item>
    </style>

    <style name="FragmentBg">
        <item name="android:background">@color/white</item>
    </style>

    <style name="IconSearchStyle">
        <item name="android:icon">@drawable/ic_search_light</item>
    </style>

    <style name="IconMediaStyle">
        <item name="android:icon">@drawable/ic_media_light</item>
    </style>

    <style name="IconSettingsStyle">
        <item name="android:icon">@drawable/ic_settings_light</item>
    </style>

</resources>